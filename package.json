{
   "name": "@faulkj/toaster",
   "version": "2.2.0",
   "description": "A highly customizable vanilla JavaScript library used to cleanly serve toast notifications.",
   "type": "module",
   "main": "dist/js/toaster.esm.js",
   "module": "dist/js/toaster.esm.js",
   "typings": "toaster.d.ts",
   "publishConfig": {
      "access": "public"
   },
   "files": [
      "dist",
      "src",
      "toaster.d.ts"
   ],
   "scripts": {
      "check": "tsc --noEmit",
      "build:js": "rollup -c --configPlugin typescript",
      "build:css": "sass src/scss/toaster.scss dist/css/toaster.css && sass src/scss/toaster.scss dist/css/toaster.min.css --style=compressed",
      "build": "rimraf dist && npm run build:js && npm run build:css",
      "prepack": "npm run build"
   },
   "repository": {
      "type": "git",
      "url": "git+https://github.com/faulkj/toaster.git"
   },
   "keywords": [
      "toast",
      "notifications",
      "javascript",
      "vanilla javascript"
   ],
   "author": "Joshua Faulkenberry <j@joshuafaulkenberry.com> (https://joshuafaulkenberry.com/)",
   "license": "Kopimi",
   "homepage": "https://github.com/faulkj/toaster#readme",
   "bugs": {
      "url": "https://github.com/faulkj/toaster/issues"
   },
   "devDependencies": {
      "@rollup/plugin-terser": "^1.0.0",
      "@rollup/plugin-typescript": "^12.3.0",
      "@types/node": "^26.2.0",
      "rimraf": "^6.1.3",
      "rollup": "^4.62.4",
      "sass": "^1.102.0",
      "tslib": "^2.8.1",
      "typescript": "^6.0.3"
   }
}
